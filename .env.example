# Copia este archivo a .env y completa los valores. .env no se versiona.
# Solo para uso local: no reutilices estas variables en otros entornos.

# --- PostgreSQL ---
POSTGRES_DB=verabank
# Superusuario de arranque; no lo usa ningún servicio de negocio.
POSTGRES_USER=verabank_admin
POSTGRES_PASSWORD=
# Contraseñas de los roles por servicio (ADR-09), creados por db/init/roles.sql.
VERABANK_TRANSFER_PASSWORD=
VERABANK_RISK_PASSWORD=
VERABANK_BI_PASSWORD=
# Puerto en el host (solo 127.0.0.1).
POSTGRES_PORT=5432

# --- Kafka (KRaft, un solo broker) ---
# Identificador del clúster: 22 caracteres base64url (16 bytes). Genera uno propio con:
#   docker run --rm apache/kafka:4.3.2 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=
# Puerto del listener para clientes en el host (solo 127.0.0.1).
KAFKA_EXTERNAL_PORT=29092
