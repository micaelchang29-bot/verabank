{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verabank/events/AmlAlertRaised.v1.schema.json",
  "title": "Alerta AML emitida (payload)",
  "type": "object",
  "required": [
    "alert_id",
    "rule_code",
    "rule_version",
    "severity",
    "subject_account_id",
    "transfer_ids",
    "total_amount",
    "window_start",
    "window_end"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid"
    },
    "rule_code": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "integer",
      "minimum": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "subject_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "transfer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1
    },
    "total_amount": {
      "type": "string",
      "pattern": "^[0-9]{1,16}(\\.[0-9]{1,2})?$",
      "description": "Monto como cadena decimal, nunca como número de coma flotante."
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
