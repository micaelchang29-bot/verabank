{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verabank/events/TransferScored.v1.schema.json",
  "title": "Transferencia puntuada (payload)",
  "type": "object",
  "required": [
    "transfer_id",
    "decision",
    "decision_source",
    "model_version",
    "latency_ms"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "format": "uuid"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REVIEW",
        "BLOCK"
      ]
    },
    "decision_source": {
      "type": "string",
      "enum": [
        "MODEL",
        "FALLBACK"
      ]
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "$comment": "Cambio de contrato registrado en ADR-12 (D7): `score` ya no es obligatorio cuando decision_source es FALLBACK, porque sin modelo no hay score (core.transfers.fraud_score queda NULL y model_version es 'fallback-v1'). Con decision_source MODEL sigue siendo obligatorio.",
  "if": {
    "properties": {
      "decision_source": {
        "const": "FALLBACK"
      }
    },
    "required": [
      "decision_source"
    ]
  },
  "then": {},
  "else": {
    "required": [
      "score"
    ]
  }
}
