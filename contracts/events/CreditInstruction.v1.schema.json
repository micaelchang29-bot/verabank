{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verabank/events/CreditInstruction.v1.schema.json",
  "title": "Instrucción de abono al rail (payload)",
  "type": "object",
  "required": [
    "transfer_id",
    "dest_external_ref",
    "dest_country",
    "amount",
    "currency"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "format": "uuid"
    },
    "dest_external_ref": {
      "type": "string",
      "minLength": 1
    },
    "dest_country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]{1,16}(\\.[0-9]{1,2})?$",
      "description": "Monto como cadena decimal, nunca como número de coma flotante."
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "additionalProperties": true
}
